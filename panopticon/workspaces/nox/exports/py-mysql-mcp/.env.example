# ===== MySQL 连接配置 =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database

# 连接池最大连接数
MYSQL_POOL_SIZE=10

# 只读模式：true 时 mysql_query 仅允许 SELECT/SHOW/DESCRIBE/EXPLAIN，mysql_execute 完全禁用
MYSQL_READ_ONLY=false

# ===== MCP HTTP 服务配置 =====
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000

# ===== 可选：完整连接串覆盖（用于「一次编写、多库适配」，仅本地演示/测试用）=====
# 设置后可不填 MYSQL_* 。示例：
# DATABASE_URL=sqlite:///./demo.db
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/mydb?charset=utf8mb4
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/mydb
